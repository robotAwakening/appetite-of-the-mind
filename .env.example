# Copy this file to .env and fill it in. Never commit .env.

# Public address of the site (used for Stripe redirects and unsubscribe links)
PUBLIC_URL=http://localhost:8000
PORT=8000

# Stripe: https://dashboard.stripe.com/apikeys  (start with sk_test_... keys)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint you create in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# Optional fallback if Stripe isn't set up yet, e.g. https://ko-fi.com/yourname
KOFI_URL=

CURRENCY=eur
BASE_AMOUNT_CENTS=200
GOAL_SUPPORTERS=1000000

# Long random string; open the dashboard at /dashboard?key=THIS
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_KEY=

# Where the SQLite database lives (default: data/campaign.db)
# DB_PATH=
